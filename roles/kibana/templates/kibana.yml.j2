server.name: kibana
server.port: 5601
server.host: "0.0.0.0"
server.publicBaseUrl: "https://192.168.56.200:5601"

elasticsearch.hosts: ["https://elasticsearch.local:9200"]
elasticsearch.username: "kibana_system"
elasticsearch.password: "{{ kibana_system_password }}"
elasticsearch.ssl.certificateAuthorities: ["/etc/kibana/certs/ca.crt"]
elasticsearch.ssl.verificationMode: full

telemetry.enabled: false

xpack.security.enabled: true
xpack.encryptedSavedObjects.encryptionKey: "{{ kibana_encryption_key }}"
xpack.reporting.encryptionKey: "{{ kibana_encryption_key }}"

server.ssl.enabled: true
server.ssl.certificate: /etc/kibana/certs/http.crt
server.ssl.key: /etc/kibana/certs/http.key