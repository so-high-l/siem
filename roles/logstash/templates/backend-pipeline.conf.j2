input {
  beats {
    port => 5044
    ssl_enabled => true
    ssl_certificate => "/etc/logstash/certs/http.crt"
    ssl_key => "/etc/logstash/certs/http.key"
  }
}

filter {
  if [log_type] == "backend_logs" {
    mutate {
      gsub => [
        "message", "^0(?=\d{2}/)", "20"
      ]
    }
  }

  grok {
    match => {
      "message" => "^%{YEAR:year}/%{MONTHNUM:month}/%{MONTHDAY:day} %{TIME:time} , %{DATA:logger} , %{LOGLEVEL:log_level} , %{GREEDYDATA:log_content}"
    }
    add_tag => ["backend_parsed"]
    tag_on_failure => []
  }

  mutate {
    add_field => {
      "log_timestamp" => "%{year}/%{month}/%{day} %{time}"
    }
  }

  date {
    match => ["log_timestamp", "yyyy/MM/dd HH:mm:ss"]
    target => "@timestamp"
    timezone => "Africa/Casablanca"
  }

  if [logger] =~ /^sqlalchemy/ {
    mutate {
      gsub => ["log_content", "'", "\""]
    }

    if [log_content] =~ /^{.*}$/ {
      json {
        source => "log_content"
        target => "sql_meta"
        skip_on_invalid_json => true
      }

      if [sql_meta][name] {
        mutate {
          replace => { "sql_query" => "%{[sql_meta][name]}" }
          remove_field => ["sql_meta"]
        }
      }
    }

    mutate {
      gsub => [
        "sql_query", "\\n", " ",
        "sql_query", "\\s+", " ",
        "sql_query", "^\\s+", "",
        "sql_query", "\\s+$", ""
      ]
    }

    grok {
      match => { "sql_query" => "^%{WORD:sql_operation}" }
    }

    grok {
      match => {
        "sql_query" => [
          "(?i)(?:FROM|INTO|UPDATE)\\s+(?:[a-zA-Z_]+\\.)?\"?(?<sql_table>[a-zA-Z_][a-zA-Z0-9_]*)\"?(?:\\s|;|$)",
          "(?i)JOIN\\s+(?:[a-zA-Z_]+\\.)?\"?(?<sql_table>[a-zA-Z_][a-zA-Z0-9_]*)\"?(?:\\s|;|$)"
        ]
      }
    }

    grok {
      match => {
        "sql_query" => "(?i)WHERE\\s+(?<where_clause>.+?)(?:GROUP BY|ORDER BY|LIMIT|$)"
      }
    }

    grok {
      match => {
        "sql_query" => "(?::%{DATA:param_name})"
      }
      tag_on_failure => []
    }
  }

  else if [logger] == "werkzeug" {
    grok {
      match => {
       "log_content" => '%{IP:client_ip} - - \[%{MONTHDAY}/%{MONTH}/%{YEAR} %{TIME:access_time}\] "(?<method>GET|POST|PUT|DELETE|PATCH|OPTIONS|HEAD) %{URIPATH:request}(?:\?%{GREEDYDATA:query})? HTTP/%{NUMBER:http_version}" %{NUMBER:status_code} -'
      }
      tag_on_failure => ["_grokparsefailure_werkzeug"]
      add_tag => ["werkzeug"]
    }

    grok {
      match => {
        "request" => "^%{URIPATH:path}(?:\\?%{GREEDYDATA:query})?"
      }
    }

    kv {
      source => "query"
      field_split => "&"
      value_split => "="
      target => "request_params"
    }

    # geoip {
    #   source => "client_ip"
    #   target => "geoip"
    #   database => "/etc/logstash/geoip/GeoLite2-City.mmdb"
    #   fields => ["city_name", "country_name", "location", "continent_name", "region_name"]
    #   tag_on_failure => ["_geoip_lookup_failure"]
    # }

    ruby {
      code => '
        if event.get("request_params")
          new_params = {}
          event.get("request_params").each do |k, v|
            clean_key = k.sub(/^\?/, "")
            new_params[clean_key] = v
          end
          event.set("request_params", new_params)
        end
      '
    }

    mutate {
      remove_field => ["query"]
    }

    ruby {
      code => '
        if event.get("status_code")
          code = event.get("status_code").to_i
          group = case code
                  when 200..299 then "2xx Success"
                  when 400..499 then "4xx Client Error"
                  when 500..599 then "5xx Server Error"
                  else "Other"
                  end
          event.set("status_code_group", group)
        end
      '
    }

    mutate {
      add_field => {
        "log_type" => "werkzeug"
      }
    }
  }

  mutate {
    remove_field => [
      "log_timestamp", "year", "month", "day", "time",
      "host", "agent", "ecs", "input", "log"
    ]
  }
}

output {
  if [logger] =~ /^sqlalchemy/ {
    elasticsearch {
      hosts => ["https://elasticsearch.local:9200"]
      index => "sqlalchemy-logs-%{+YYYY.MM.dd}"
      user => "logstash_internal"
      password => "{{ logstash_password }}"
      ssl_verification_mode => "full"
      ssl_enabled => true
      ssl_certificate_authorities  => "/etc/logstash/certs/ca.crt"
    }
  } else if [logger] == "werkzeug" {
    elasticsearch {
      hosts => ["https://elasticsearch.local:9200"]
      index => "werkzeug-logs-%{+YYYY.MM.dd}"
      user => "logstash_internal"
      password => "{{ logstash_password }}"
      ssl_verification_mode => "full" 
      ssl_enabled => true
      ssl_certificate_authorities  => "/etc/logstash/certs/ca.crt"
    }
  } else {
    elasticsearch {
      hosts => ["https://elasticsearch.local:9200"]
      index => "unclassified-logs-%{+YYYY.MM.dd}"
      user => "logstash_internal"
      password => "{{ logstash_password }}"
      ssl_verification_mode => "full"
      ssl_enabled => true
      ssl_certificate_authorities  => "/etc/logstash/certs/ca.crt"
    }
  }
}
