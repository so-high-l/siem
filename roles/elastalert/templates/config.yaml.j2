rules_folder: {{ elastalert_rules_dir }}

run_every:
  minutes: 1

buffer_time:
  minutes: 15

es_host: {{ elasticsearch_host }}
es_port: {{ elasticsearch_port }}

use_ssl: True

verify_certs: false

es_username: elastic
es_password: {{ elastic_password }}


writeback_index: elastalert_status


alert_time_limit:
  days: 2
